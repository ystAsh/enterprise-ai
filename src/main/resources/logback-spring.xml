<?xml version="1.0" encoding="UTF-8"?>

<!--
=============================================================================
파일명 : logback-spring.xml
=============================================================================
목적
 - Hibernate가 생성한 SQL을 개발/장애 분석용 파일에 기록한다.
 - 실제 JDBC 바인딩 파라미터 값은 기록하지 않는다.
 - 로그를 날짜/용량 기준으로 순환하고 30일 후 자동 삭제한다.
 - SQL 로그를 일반 애플리케이션 로그와 분리한다.
=============================================================================
-->

<configuration>

    <!-- 일반 애플리케이션 Console 로그 -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- Hibernate SQL 전용 파일 -->
    <appender name="HIBERNATE_SQL_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>logs/hibernate-sql.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- 이전 로그는 gzip 압축 -->
            <fileNamePattern>
                logs/archive/hibernate-sql.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <!-- 파일 하나의 최대 크기 -->
            <maxFileSize>20MB</maxFileSize>

            <!-- 30일 보관 후 자동 삭제 -->
            <maxHistory>30</maxHistory>

            <!-- SQL 로그 전체 용량 제한 -->
            <totalSizeCap>500MB</totalSizeCap>

            <!-- 애플리케이션 시작 시 오래된 로그도 정리 -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>


    <!--
        Hibernate가 생성한 SQL만 기록한다.

        실제 바인딩 값을 출력하는
        org.hibernate.orm.jdbc.bind TRACE logger는
        의도적으로 설정하지 않는다.
    -->
    <logger name="org.hibernate.SQL"
            level="DEBUG"
            additivity="false">

        <appender-ref ref="HIBERNATE_SQL_FILE"/>

    </logger>


    <!-- 일반 Spring Boot 로그 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>